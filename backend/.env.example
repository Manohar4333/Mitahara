# MITAHARA Backend Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration (Atlas or local)
# Leave empty to automatically use embedded in-memory MongoDB in dev!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mitahara?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=mitahara_super_secret_jwt_key_2026_health_organic
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=mitahara_super_secret_refresh_jwt_key_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# SMTP Configuration (Nodemailer Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=manoharthappetla@gmail.com
SMTP_PASS=
SMTP_FROM="MITAHARA Pure Organic" <manoharthappetla@gmail.com>

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
OTP_RESEND_COOLDOWN_SEC=60
OTP_EXPIRY_MIN=5
OTP_MAX_ATTEMPTS=5

# Admin Auto-Setup Seed Credentials (Optional, defaults to admin@mitahara.online)
ADMIN_EMAIL=admin@mitahara.online
ADMIN_NAME=Mitahara Admin
